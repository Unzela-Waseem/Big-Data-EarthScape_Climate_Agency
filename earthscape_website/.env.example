MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=
ANALYST_USERNAME=replace-with-analyst-username
ANALYST_PASSWORD=replace-with-a-different-password-at-least-12-chars
# Optional path to cleaned notebook exports (monthly_climate.csv, annual_ghg.csv, forecast.csv)
DATA_DIR=./data/cleaned
